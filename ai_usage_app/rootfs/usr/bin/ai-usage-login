#!/usr/bin/env bash
# Runs a CLI's own sign-in in the web terminal: ai-usage-login claude|gemini|codex|shell
cd /data/work || exit 1

refresh() {
    curl -fsS -X POST -H "Authorization: Bearer $(cat /data/api_token)" \
        http://127.0.0.1:8080/api/v1/refresh >/dev/null \
        && echo "Signed in. Usage will be checked again now."
}

# Run a sign-in command until it succeeds or the user gives up (Ctrl+C).
sign_in() {
    until "$@"; do
        echo
        read -r -p "Sign-in didn't complete. Press Enter to try again, or Ctrl+C to stop. " _ || return 1
    done
    refresh
}

paste_help() {
    echo "  Paste with Ctrl+V (Cmd+V on a Mac) or right-click -> Paste, then press Enter."
    echo "  The pasted code may not be shown on screen: that's normal."
}

case "${1:-shell}" in
    claude)
        echo "Signing in to Claude Code with your Claude subscription."
        echo
        echo "  1. Open the link below (it opens in a new tab) and approve."
        echo "  2. Copy the code it shows and paste it at the prompt here."
        paste_help
        echo
        sign_in claude auth login --claudeai
        ;;
    gemini)
        echo "Signing in to the Antigravity CLI with your Google account."
        echo
        echo "  1. Open the link below (it opens in a new tab) and approve."
        echo "  2. Copy the code it shows and paste it at the prompt here."
        paste_help
        echo "  3. Once the Antigravity CLI is running, type /exit and press Enter."
        echo
        sign_in agy
        ;;
    codex)
        echo "Signing in to Codex with your ChatGPT account (device code)."
        echo
        echo "  Device-code sign-in must be enabled first: ChatGPT -> Settings -> Security."
        echo "  Then open the link below and enter the code shown here."
        echo
        sign_in codex login --device-auth
        ;;
    *) ;;
esac
echo
echo "You can close this tab, or keep using this shell."
exec bash -l
